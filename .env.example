# ==============================================================================
# POC Servicio al Cliente SKF — variables de entorno locales
# ==============================================================================
# Este archivo NO se sube a git (está en .gitignore).
# Rellena los valores marcados con <...> y avísame para verificar la conexión.
# ==============================================================================


# ── SUPABASE — cliente (se exponen al navegador) ──────────────────────────────
# Dashboard → Project Settings → Data API   /   → API Keys

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ── SUPABASE — servidor (NUNCA se exponen al navegador) ───────────────────────
# Dashboard → Project Settings → API Keys → revelar service_role

SUPABASE_SERVICE_ROLE_KEY=


# ── SUPABASE — CLI y siembra masiva ───────────────────────────────────────────
# PROJECT_REF   : Settings → General → Reference ID (la cadena de la URL)
# ACCESS_TOKEN  : https://supabase.com/dashboard/account/tokens → Generate new token
# DB_PASSWORD   : la que definiste al crear el proyecto
#                 (si la perdiste: Settings → Database → Reset database password)
# DB_URL        : Settings → Database → Connection string → pestaña "Session pooler"
#                 Copia el URI completo y sustituye [YOUR-PASSWORD] por la real.
#                 Usamos el pooler y no la conexión directa porque la directa es
#                 IPv6 y suele fallar desde redes domésticas.

SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_URL=


# ── VERCEL AI GATEWAY ─────────────────────────────────────────────────────────
# Vercel Dashboard → AI Gateway → API Keys → Create key
# El modelo se enruta por Gateway; cambiarlo aquí no requiere tocar código.

AI_GATEWAY_API_KEY=
CHAT_MODEL=anthropic/claude-sonnet-5


# ── PARÁMETROS DEL POC ────────────────────────────────────────────────────────
# DEMO_SEED     : semilla fija del generador. Con el mismo valor, la base se
#                 reconstruye idéntica antes de una presentación.
# CHAT_RESPALDO : "true" activa las respuestas pregrabadas del guion, para el
#                 caso de que falle la red o el Gateway en la sala del cliente.
# CHAT_LIMITE   : tope de mensajes por sesión, por si la URL se comparte.

DEMO_SEED=20260803
CHAT_RESPALDO=false
CHAT_LIMITE_MENSAJES=60
